{
  "apiName": "smart_dock",
  "label": "Smart Dock",
  "category": "Navigation",
  "description": "iOS-style dock of up to six icons. Each item has its own action (open a page or run a Flow); add one to each layout.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 1,
  "scope": "platform-core",
  "jsxFile": "component-libraries/smart_dock/SmartComponent.jsx",
  "cssFile": "component-libraries/smart_dock/SmartComponent.css",
  "resize": {
    "defaultWidth": 360,
    "defaultHeight": 72,
    "minWidth": 64,
    "minHeight": 44
  },
  "propertyDefinitions": [],
  "eventDefinitions": [
    {"apiName": "click", "label": "Any item tapped"},
    {"apiName": "dockItem1", "label": "Item 1 tapped"},
    {"apiName": "dockItem2", "label": "Item 2 tapped"},
    {"apiName": "dockItem3", "label": "Item 3 tapped"},
    {"apiName": "dockItem4", "label": "Item 4 tapped"},
    {"apiName": "dockItem5", "label": "Item 5 tapped"},
    {"apiName": "dockItem6", "label": "Item 6 tapped"},
    {"apiName": "dockItem7", "label": "Item 7 tapped"},
    {"apiName": "dockItem8", "label": "Item 8 tapped"},
    {"apiName": "dockItem9", "label": "Item 9 tapped"},
    {"apiName": "dockItem10", "label": "Item 10 tapped"},
    {"apiName": "dockItem11", "label": "Item 11 tapped"},
    {"apiName": "dockItem12", "label": "Item 12 tapped"}
  ]
}
